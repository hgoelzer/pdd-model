#!/bin/bash
#SBATCH --job-name=gpdd
# Accounts: CLIM2Ant: nn11016k, ISMIP7: nn5011k, GREASE: nn8006k
#SBATCH --account=nn5011k
#SBATCH --time=04:00:00
#SBATCH --mem-per-cpu=4G   # 4G sufficient for 2-16km; use 8G for 1km
#SBATCH --qos=preproc
## Sequential run:
#SBATCH --ntasks=1
## OpenMP parallel run — uncomment and set threads to match cpus-per-task:
##SBATCH --cpus-per-task=1

set -o errexit
set -o nounset

## Load the same module environment used for compilation.
## SLURM_SUBMIT_DIR is the directory from which sbatch was called.
SCRIPT_DIR="${SLURM_SUBMIT_DIR:-$(dirname "$0")}"
source "${SCRIPT_DIR}/setenv.sh"
module list

## Namelist: pass as positional argument to sbatch, e.g.:
##   sbatch runPDD params_CESM2_historical_anom_16km.nml
NML=${1:-params.nml}

## OpenMP thread count — uncomment when using cpus-per-task > 1
## export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}

echo "=== Running: ./gpdd_monthly_inout.x ${NML} ==="
time srun ./gpdd_monthly_inout.x ${NML}

## MPI parallel run: srun picks up --ntasks from the #SBATCH header above

exit 0
