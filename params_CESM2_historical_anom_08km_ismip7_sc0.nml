&config
  ! ISMIP7 GrIS corrected rerun (mrro = total runoff, sir = retained meltwater;
  ! all other variables bit-identical to the original SMBMIP submission).
  ! CESM2 historical 1950-2014, 8 km, seasonalcycle=0 sensitivity, all 9 vars, monthly, SMBMIP units.
  outputmode = 0
  outputvars = 0
  fmode = 1
  deflate_level = 9

  inpathname_pr  = "./Forcing/CESM2/historical/pr_ratio"
  inpathname_tas = "./Forcing/CESM2/historical/tas_anom"
  fileroot_pr    = "pr_ratio_Amon_CESM2_historical_r11i1p1f1"
  fileroot_tas   = "tas_Amon_CESM2_historical_r11i1p1f1"

  year0        = 1950
  nt           = 65
  time_ref_year = 1850
  fileroot_out = "GIS_NORCEPDD1_CESM2_Historical_r11i1p1f1"

  ! Grid: 8 km ISMIP7 GrIS
  nx         = 211
  ny         = 361
  res        = 8000.0
  res_suffix = "i08000m"

  ! Reference files (fmode=1): pr = Lindsey-Clark2026 bias-corrected MARv3.14
  filename_prref   = "Forcing/MARv3.14LC26/pr_ref_MARv3.14LC26-monthly-ERA5-1960-1989_08000m.nc"
  filename_tasref  = "Forcing/MARv3.14LC26/tas_ref_MARv3.14-monthly-ERA5-1960-1989_08000m.nc"
  filename_defmask = "Forcing/constant/sftgif_promice_08000m.nc"

  outpathname = "./output_sc08/Historical"

  institution   = "NORCE Research"
  contact_name  = "Heiko Goelzer"
  contact_email = "heig@norceresearch.no"

  ! PDD physics parameters (production defaults, identical to submission)
  ddfactorsnow = 0.00297
  ddfactorice  = 0.00791
  sigma        = 4.5
  rainlimit    = 1.0

  ! Retention: max fraction of monthly snowfall retained
  ! (Janssens and Huybrechts 2000)
  pmax = 0.3

  ! Seasonal cycle: 1 = prescribed July-peak cycle (production configuration)
  seasonalcycle = 0

  ! Output grid: ISMIP6 GrIS (epsg:3413), production origins
  x0 = -720000.0
  y0 = -3450000.0
  grid_information = "ISMIP6 grid, epsg:3413"
/
